[Unit]
Description=Telegram to X automation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telegram-x
Group=telegram-x
WorkingDirectory=/opt/telegram-x
EnvironmentFile=/etc/telegram-x/worker.env
Environment=HEALTH_PATH=/var/lib/telegram-x/health.json
ExecStart=/opt/telegram-x/.venv/bin/python /opt/telegram-x/main.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
