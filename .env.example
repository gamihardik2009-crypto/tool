# Copy this file to `.env` and fill in your values.
# Your real token is already in `.env` (kept out of git).

# Required: the bot token from @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC-your-token

# Optional: restrict collection to a single group. Telegram group ids are
# usually negative numbers, e.g. -1001234567890. Leave blank to accept any chat.
TELEGRAM_CHAT_ID=

# Where to store the SQLite database and the log file.
DATABASE_PATH=data/messages.db
LOG_PATH=data/collector.log

# Existing flat JSON cookie session used by tweetkit-x.
X_SESSION_PATH=../X-auto-poster/session.json
HEALTH_PATH=data/health.json
